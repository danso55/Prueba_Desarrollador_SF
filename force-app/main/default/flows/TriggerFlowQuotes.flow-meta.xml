        </assignmentItems>
    </assignments>
    <environments>Default</environments>
    <formulas>
        <name>Name</name>
        <dataType>String</dataType>
        <expression>IF(
    {!$Record.Opportunity.Numero_de_versiones_de_presupuesto__c} + 1 &lt;= 1,

    {!$Record.Name} &amp;
    &quot; - Version &quot; &amp;
    TEXT(
        {!$Record.Opportunity.Numero_de_versiones_de_presupuesto__c} + 1
    ),
LEFT(
            {!$Record.Name},
            FIND(&quot; - Version&quot;, {!$Record.Name}) - 1
        ) &amp;
        &quot; - Version &quot; &amp;
        TEXT(
            {!$Record.Opportunity.Numero_de_versiones_de_presupuesto__c} + 1
        )
)</expression>
    </formulas>
    <formulas>
        <name>Uniquekey</name>
        <dataType>String</dataType>
        <expression>{!$Record.OpportunityId} &amp;&quot;-&quot;&amp; TEXT({!$Record.Opportunity.Numero_de_versiones_de_presupuesto__c}+1)</expression>
    </formulas>
    <formulas>
        <name>Versionthequote</name>
        <dataType>Number</dataType>
        <expression>{!$Record.Opportunity.Numero_de_versiones_de_presupuesto__c}+1</expression>
        <scale>2</scale>
    </formulas>
