            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.VersionKey__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Uniquekey</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Name</assignToReference>
